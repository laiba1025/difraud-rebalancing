# Python virtual environment (recreate: see README, "Recreating the environment and data")
.venv/

# UNIDECOR repository clone, its downloaded components and the consolidated JSON
# (recreate: see README)
unidecor_repo/

# Python bytecode
__pycache__/
*.py[cod]

# Downloaded / cached data. DiFrauD and the convokit Diplomacy corpus are cached outside the
# project (~/.cache/huggingface, ~/.convokit); these patterns catch any local copies.
.cache/
data/raw/
*.tar.gz
*.zip
*.pkl

# Derived artefacts, regenerated by the scripts in src/ (see README)
cache/
models/
